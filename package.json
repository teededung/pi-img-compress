{
  "name": "pi-img-compress",
  "version": "0.1.1",
  "description": "Auto-compress pasted and referenced local images into Pi ImageContent attachments with atomic clickable [imageN] editor placeholders.",
  "type": "module",
  "main": "./src/index.ts",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "image",
    "compress",
    "resize",
    "clipboard"
  ],
  "author": "teededung",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teededung/pi-img-compress.git"
  },
  "homepage": "https://github.com/teededung/pi-img-compress#readme",
  "bugs": {
    "url": "https://github.com/teededung/pi-img-compress/issues"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts"
  }
}
